# Alma Creativa — variables de entorno
# Copiá este archivo a .env.local y completá con las credenciales de Supabase.
#   cp .env.example .env.local
#
# En Supabase: Project Settings → API.

# URL del proyecto (https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# anon / public key (va al cliente, es segura)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key — SECRETA. Solo server-side (guardar leads).
# NUNCA le pongas el prefijo NEXT_PUBLIC_ ni la uses en el navegador.
SUPABASE_SERVICE_ROLE_KEY=

# (opcional) ref del proyecto, para `npm run db:types`. Es el subdominio de la URL.
SUPABASE_PROJECT_ID=

# --- Meta (Instagram / Messenger / WhatsApp) — bandeja de Leads ---
# App en developer.facebook.com → Settings → Basic.
META_APP_SECRET=
# Lo elegís vos (string random). El mismo valor va en el panel de Meta al
# configurar el webhook (Verify token).
META_VERIFY_TOKEN=
# Token permanente de un System User (Business Settings → Users → System users).
# No expira. Da acceso al Graph API para enviar.
META_GRAPH_TOKEN=
# IDs por canal (para construir las URLs de envío).
WHATSAPP_PHONE_NUMBER_ID=
IG_USER_ID=
PAGE_ID=
